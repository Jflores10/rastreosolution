# Puerto HTTP del microservicio
PORT=3100

# Interfaz donde escucha. Usar 127.0.0.1 si Laravel está en el mismo servidor
# (así el servicio no queda expuesto a internet).
HOST=127.0.0.1

# Clave que deben enviar los clientes en el header x-api-key (y en ?key= para GET /qr).
# Generar una larga y aleatoria, por ejemplo: openssl rand -hex 32
API_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Código de país por defecto para normalizar números locales (Ecuador = 593)
CODIGO_PAIS=593

# Carpeta donde LocalAuth guarda la sesión de WhatsApp (no borrar o habrá que escanear el QR de nuevo)
SESSION_DIR=./.wwebjs_auth

# Pausa aleatoria entre mensajes (en milisegundos)
PAUSA_MIN_MS=3000
PAUSA_MAX_MS=8000

# Máximo de envíos esperando en la cola; por encima se responde 429
MAX_COLA=100

# Ruta al ejecutable de Chrome/Chromium (opcional). Vacío = usar el Chromium que descarga Puppeteer.
CHROME_PATH=

# Versión de WhatsApp Web a usar (opcional). Útil cuando una actualización de WhatsApp rompe la librería.
# Ejemplo: 2.3000.1017054665  (ver https://github.com/wppconnect-team/wa-version)
WWEBJS_WEB_VERSION=
